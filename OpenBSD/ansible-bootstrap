#!/bin/sh
#
# ansible-bootstrap — OpenBSD implementation, v0.2
#
# init:
#   ANSIBLE_PUBLIC_KEY='ssh-ed25519 ...' \
#     ANSIBLE_EXPECTED_FINGERPRINT='SHA256:...' \
#     ansible-bootstrap init
#
# check:
#   ansible-bootstrap check
#
# apply:
#   ansible-bootstrap apply
#
# Must run as root. Never accepts an SSH private key.

set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/bin
export PATH

ACCOUNT=ansible
HOME_DIR=/home/ansible
LOGIN_SHELL=/bin/ksh

CONFIG_DIR=/etc/ansible-bootstrap
KEY_FILE=$CONFIG_DIR/controller.pub

DOAS_CONF=/etc/doas.conf
DOAS_BEGIN='# BEGIN ansible-bootstrap'
DOAS_END='# END ansible-bootstrap'

# The v0.2 marker, recognized so an upgrade does not append a second
# copy of the rule.
DOAS_LEGACY='# Managed by ansible-bootstrap'

# Managed-node interpreter requirements of the ansible-core release
# the controller runs. Set here for ansible-core 2.21, which supports
# managed nodes on Python 3.9 through 3.14. Re-derive these from the
# support matrix when the controller's ansible-core changes; they are
# not universal OpenBSD or Ansible policy. PYTHON_MAX may be empty,
# meaning no upper bound, but every released ansible-core has one.
PYTHON_MIN=3.9
PYTHON_MAX=3.14

# Package stem of the interpreter. The exact version to install is
# chosen from what the repository actually offers, so no release-
# specific version is hardcoded here.
PYTHON_PACKAGE_STEM=python

# Where OpenBSD packages install interpreters.
PYTHON_DIR=/usr/local/bin

# Wall-clock bound in seconds on a package operation. rc.local is a
# startup script, not a supervised service manager: an unreachable
# mirror must fail and return control to the boot sequence rather than
# stall it indefinitely.
PKG_TIMEOUT=300

# Exit-status contract:
#   0  ready, or reconciliation succeeded
#   1  a prerequisite is missing, or reconciliation failed
#   2  invalid invocation, or this service's own configuration is
#      absent, malformed, or unsafe
#
# The dividing line: status 2 means the inputs are wrong and repeating
# the run cannot help; status 1 means the managed host state is wrong,
# which a later boot or a manual apply may resolve.
EX_NOTREADY=1
EX_CONFIG=2

log()
{
    printf 'ansible-bootstrap: %s\n' "$*" >&2
}

die()
{
    log "ERROR: $*"
    exit "$EX_NOTREADY"
}

die_config()
{
    log "ERROR: $*"
    exit "$EX_CONFIG"
}

require_root()
{
    [ "$(id -u)" -eq 0 ] || die_config "Run as root"
}

# Mode string and numeric owner and group of a path, as
# "<ten-character mode> <uid> <gid>". Empty if the path is absent.
# ls(1) is used because stat(1) format flags are not portable across
# the BSDs; -n keeps the IDs numeric so no name lookup is involved.
path_status()
{
    ls -ldn "$1" 2>/dev/null |
        awk 'NR == 1 { print substr($1, 1, 10), $3, $4 }'
}

# True when a path has exactly the expected "<mode> <uid> <gid>".
expect_path()
{
    [ "$(path_status "$1")" = "$2" ]
}

# True when a path is writable by neither group nor other, which is
# what sshd's StrictModes requires of a home directory. Positions 6
# and 9 of the mode string are the group and other write bits.
owner_writable_only()
{
    mode=$(path_status "$1")
    mode=${mode%% *}

    [ -n "$mode" ] || return 1

    case "$mode" in
        ?????w????) return 1 ;;
        ????????w?) return 1 ;;
    esac
}

# Run a command under a wall-clock bound, returning its own exit
# status, or 124 if it had to be killed. Implemented with a poll loop
# rather than timeout(1) so there is no dependency to confirm on the
# target release. stdin is closed: a package tool that decides to ask
# a question must fail rather than wait at boot for an answer that
# will never come.
run_bounded()
{
    limit=$1
    shift

    # Job control puts the command in its own process group, so the
    # whole group can be signalled. Killing only the direct child
    # would leave pkg_add's fetch process running and holding the
    # descriptors it inherited.
    set -m
    "$@" < /dev/null &
    bounded_pid=$!
    set +m

    waited=0
    while [ "$waited" -lt "$limit" ]; do
        kill -0 "$bounded_pid" 2>/dev/null || break
        sleep 1
        waited=$((waited + 1))
    done

    if kill -0 "$bounded_pid" 2>/dev/null; then
        log "Exceeded ${limit}s; terminating: $*"

        # Fall back to the single process if this shell did not make
        # the job a group leader.
        signal_bounded TERM
        sleep 2
        signal_bounded KILL

        wait "$bounded_pid" 2>/dev/null

        return 124
    fi

    wait "$bounded_pid"
}

signal_bounded()
{
    kill "-$1" "-$bounded_pid" 2>/dev/null ||
        kill "-$1" "$bounded_pid" 2>/dev/null ||
        return 0
}

# Compare SSH key type and base64 material, ignoring comments.
key_fields()
{
    awk 'NF >= 2 { print $1, $2; exit }' "$1"
}

validate_key()
{
    [ -f "$1" ] && [ ! -L "$1" ] || return 1

    # v0.2 accepts exactly one Ed25519 public key.
    awk '
        NF == 0 { next }
        {
            count++
            if ($1 != "ssh-ed25519" || NF < 2)
                bad = 1
        }
        END { exit (count != 1 || bad) }
    ' "$1" || return 1

    ssh-keygen -lf "$1" -E sha256 >/dev/null 2>&1
}

fingerprint()
{
    ssh-keygen -lf "$1" -E sha256 |
        awk '{ print $2 }'
}

report_key()
{
    log "Controller public key fingerprint: $(fingerprint "$KEY_FILE")"
}

init_key()
{
    [ -n "${ANSIBLE_PUBLIC_KEY:-}" ] ||
        die_config "Set ANSIBLE_PUBLIC_KEY to an SSH public key"

    [ ! -L "$CONFIG_DIR" ] ||
        die_config "Refusing symlinked configuration directory"

    install -d -o root -g wheel -m 0700 "$CONFIG_DIR"

    tmp=$(mktemp "$CONFIG_DIR/controller.pub.XXXXXXXX") ||
        die "Cannot create temporary key file"

    # Remove the temporary file on initialization failure.
    trap 'rm -f "$tmp"' EXIT HUP INT TERM

    printf '%s\n' "$ANSIBLE_PUBLIC_KEY" > "$tmp"
    chmod 0600 "$tmp"

    validate_key "$tmp" ||
        die_config "Invalid public key; expected one Ed25519 key"

    actual=$(fingerprint "$tmp")
    log "Supplied public key fingerprint: $actual"

    if [ -n "${ANSIBLE_EXPECTED_FINGERPRINT:-}" ]; then
        [ "$actual" = "$ANSIBLE_EXPECTED_FINGERPRINT" ] ||
            die_config "Fingerprint does not match expected value"
        log "Expected fingerprint verified"
    else
        log "WARNING: No independent expected fingerprint supplied"
    fi

    # Refuse to silently replace an existing controller key.
    if [ -e "$KEY_FILE" ] || [ -L "$KEY_FILE" ]; then
        validate_key "$KEY_FILE" ||
            die_config "Existing controller key is invalid"

        if [ "$(key_fields "$tmp")" != "$(key_fields "$KEY_FILE")" ]; then
            die_config "A different controller key already exists; refusing replacement"
        fi

        log "Existing controller key matches"
        return 0
    fi

    mv "$tmp" "$KEY_FILE"
    chmod 0600 "$KEY_FILE"
    chown root:wheel "$KEY_FILE"

    log "Controller public key saved"
}

# The key file is the local trust anchor: a key an unprivileged user
# can rewrite is worthless, so ownership and permissions are part of
# the invariant, not just the contents.
check_key_source()
{
    validate_key "$KEY_FILE" || return 1

    [ ! -L "$CONFIG_DIR" ] || return 1

    expect_path "$CONFIG_DIR" "drwx------ 0 0" || return 1
    expect_path "$KEY_FILE" "-rw------- 0 0"
}

# Repair ownership and permissions of the stored key. Never creates or
# replaces the key itself; that is init's responsibility.
apply_key_source()
{
    check_key_source && return 0

    [ ! -L "$CONFIG_DIR" ] ||
        die_config "Refusing symlinked configuration directory"

    validate_key "$KEY_FILE" ||
        die_config "Initialize the controller public key first"

    log "Repairing ownership and permissions of $KEY_FILE"

    chown root:wheel "$CONFIG_DIR" "$KEY_FILE"
    chmod 0700 "$CONFIG_DIR"
    chmod 0600 "$KEY_FILE"

    check_key_source || die "Key configuration verification failed"
}

# Use the account database, not a guessed passwd-file layout.
account_record()
{
    getent passwd "$ACCOUNT"
}

# Numeric uid and gid of the account, as "<uid> <gid>". The passwd
# entry is the single source of truth for both checking and setting
# ownership, so neither depends on a group that happens to share the
# account name.
account_ids()
{
    record=$(account_record) || return 1

    printf '%s\n' "$record" | awk -F: '{ print $3, $4 }'
}

check_account()
{
    record=$(account_record) || return 1

    uid=$(printf '%s\n' "$record" | awk -F: '{print $3}')
    home=$(printf '%s\n' "$record" | awk -F: '{print $6}')
    shell=$(printf '%s\n' "$record" | awk -F: '{print $7}')

    [ "$home" = "$HOME_DIR" ] || return 1
    [ "$shell" = "$LOGIN_SHELL" ] || return 1
    [ -d "$HOME_DIR" ] && [ ! -L "$HOME_DIR" ] || return 1

    # sshd refuses public-key authentication when the home directory
    # is owned by anyone else or is writable by group or other.
    [ "$(path_status "$HOME_DIR" | awk '{print $2}')" = "$uid" ] || return 1
    owner_writable_only "$HOME_DIR"
}

apply_account()
{
    if ! id "$ACCOUNT" >/dev/null 2>&1; then
        log "Creating $ACCOUNT account"

        # No usable password; SSH public-key authentication is
        # configured separately.
        useradd -m -d "$HOME_DIR" -s "$LOGIN_SHELL" \
            -p '*' "$ACCOUNT"
    fi

    # The home directory belongs to the administrator, not to this
    # service; report a conflict rather than relaxing or tightening it.
    if ! check_account; then
        log "The $ACCOUNT account must have home $HOME_DIR, shell"
        log "$LOGIN_SHELL, and a home directory that it owns and that"
        log "is not writable by group or other."
        die "Account does not satisfy the readiness contract"
    fi
}

# Look for the configured key in an authorized_keys file.
#
#   mode "exact"  an ordinary entry with no preceding options, which is
#                 what the readiness contract requires
#   mode "any"    the same key material wherever it appears, including
#                 behind options such as from= or command=
#
# Options may be quoted and contain spaces, so the key is located by
# scanning for the type immediately followed by its base64 material
# rather than by assuming a field position. Comments are skipped: a
# commented-out key must not count as present in either mode.
#
# Key presence is a separate question from file ownership and
# permissions. Conflating the two would make a permission fault look
# like a missing key and append a duplicate.
authorized_key_match()
{
    [ -f "$2" ] || return 1

    awk -v mode="$1" '
        NR == FNR {
            if (NF >= 2) {
                type = $1
                key = $2
            }
            next
        }
        /^[ \t]*#/ { next }
        {
            for (i = 1; i < NF; i++) {
                if ($i != type || $(i + 1) != key)
                    continue
                if (mode == "any" || i == 1)
                    found = 1
            }
        }
        END { exit !found }
    ' "$KEY_FILE" "$2"
}

check_authorized_key()
{
    check_key_source && check_account || return 1

    ids=$(account_ids) || return 1

    ssh_dir=$HOME_DIR/.ssh
    auth=$ssh_dir/authorized_keys

    [ -d "$ssh_dir" ] && [ ! -L "$ssh_dir" ] || return 1
    [ -f "$auth" ] && [ ! -L "$auth" ] || return 1

    expect_path "$ssh_dir" "drwx------ $ids" || return 1
    expect_path "$auth" "-rw------- $ids" || return 1

    authorized_key_match exact "$auth"
}

apply_authorized_key()
{
    check_key_source || die_config "Controller public key is missing or invalid"

    ssh_dir=$HOME_DIR/.ssh
    auth=$ssh_dir/authorized_keys

    [ ! -L "$ssh_dir" ] && [ ! -L "$auth" ] ||
        die "Refusing symlinked SSH paths"

    ids=$(account_ids) || die "No passwd entry for $ACCOUNT"

    uid=${ids%% *}
    gid=${ids##* }

    # Created root-owned, then given to the account below, so the
    # ownership rule lives in exactly one place.
    if [ ! -d "$ssh_dir" ]; then
        install -d -m 0700 "$ssh_dir"
    fi

    if [ ! -e "$auth" ]; then
        install -m 0600 /dev/null "$auth"
    fi

    [ -f "$auth" ] || die "authorized_keys is not a regular file"

    if ! authorized_key_match exact "$auth"; then
        # Already there, but behind options that restrict what it can
        # do. Appending an unrestricted copy would duplicate the key
        # and quietly override a deliberate administrative narrowing.
        if authorized_key_match any "$auth"; then
            log "The controller key is present in $auth but carries"
            log "restricting options, so it cannot serve general"
            log "provisioning. Refusing to append an unrestricted"
            log "second copy of the same key."
            die "Resolve the restricted controller key entry by hand"
        fi

        log "Installing controller key: $(fingerprint "$KEY_FILE")"
        cat "$KEY_FILE" >> "$auth"
    fi

    # Repair only what is actually wrong, and say so. These are files
    # this service creates and owns, and the contract names their
    # modes, so correcting them is right — but doing it silently on
    # every run hid the fact that something had changed them, and left
    # a no-op apply still writing to files it need not touch.
    if ! expect_path "$ssh_dir" "drwx------ $ids"; then
        log "Repairing ownership and permissions of $ssh_dir"
        chown "$uid:$gid" "$ssh_dir"
        chmod 0700 "$ssh_dir"
    fi

    if ! expect_path "$auth" "-rw------- $ids"; then
        log "Repairing ownership and permissions of $auth"
        chown "$uid:$gid" "$auth"
        chmod 0600 "$auth"
    fi

    check_authorized_key ||
        die "authorized_keys verification failed"
}

# Test the effective doas policy as the ansible user.
#
# Deliberately NOT a login shell: `su -` would source /etc/profile and
# ~/.profile, whose output would be captured along with the command's
# and break the comparison below on a host where doas works fine. A
# non-login shell is also the more faithful test, because Ansible runs
# `ssh host command`, which is not a login shell either. Nothing here
# needs the login environment — doas and id are invoked by absolute
# path.
#
# The whole output must be exactly "0". Matching loosely, to tolerate
# stray output, would risk reading a bare 0 printed by something else
# as proof of success; failing on unexpected output is the safer
# direction.
check_doas()
{
    [ -f "$DOAS_CONF" ] || return 1

    result=$(su "$ACCOUNT" -c \
        '/usr/bin/doas -n /usr/bin/id -u' 2>/dev/null) ||
        return 1

    [ "$result" = 0 ]
}

# True when a previous run already wrote the managed rule.
managed_doas_rule()
{
    [ -f "$DOAS_CONF" ] || return 1

    grep -Fqx "$DOAS_BEGIN" "$DOAS_CONF" ||
        grep -Fqx "$DOAS_LEGACY" "$DOAS_CONF"
}

# True when any rule the administrator wrote names the account.
# Appending a permit rule after such a rule would silently override a
# deliberate policy decision.
administrator_doas_rule()
{
    [ -f "$DOAS_CONF" ] || return 1

    awk -v account="$ACCOUNT" '
        /^[ \t]*#/ { next }
        NF == 0 { next }
        {
            for (i = 1; i <= NF; i++)
                if ($i == account)
                    found = 1
        }
        END { exit !found }
    ' "$DOAS_CONF"
}

apply_doas()
{
    check_doas && return 0

    # The rule is already installed but is not effective. Appending
    # another copy would not change the outcome and would grow
    # doas.conf by two lines on every boot.
    if managed_doas_rule; then
        log "$DOAS_CONF already contains the managed rule for $ACCOUNT,"
        log "but doas -n still fails. A later rule may override it, or"
        log "the account may be locked or otherwise unusable."
        die "Refusing to append a duplicate doas rule; resolve this by hand"
    fi

    # An existing rule naming the account is a deliberate
    # administrative decision; report the conflict, do not outrank it.
    if administrator_doas_rule; then
        log "$DOAS_CONF already has a rule naming $ACCOUNT that does not"
        log "permit passwordless root access."
        die "Refusing to override administrator doas policy"
    fi

    log "Configuring passwordless doas"

    [ ! -L "$DOAS_CONF" ] ||
        die "Refusing symlinked doas.conf"

    doas_tmp=$(mktemp "$DOAS_CONF.XXXXXXXX") ||
        die "Cannot create temporary doas configuration"

    if [ -f "$DOAS_CONF" ]; then
        cat "$DOAS_CONF" > "$doas_tmp"
    fi

    # Last matching rule wins in doas.conf, so the managed block goes
    # at the end. The markers let later runs recognize it.
    {
        printf '\n%s\n' "$DOAS_BEGIN"
        printf 'permit nopass %s as root\n' "$ACCOUNT"
        printf '%s\n' "$DOAS_END"
    } >> "$doas_tmp"

    chmod 0600 "$doas_tmp"
    chown root:wheel "$doas_tmp"

    if ! doas -C "$doas_tmp" >/dev/null 2>&1; then
        rm -f "$doas_tmp"
        die "Generated doas configuration is invalid"
    fi

    mv "$doas_tmp" "$DOAS_CONF" || {
        rm -f "$doas_tmp"
        die "Cannot install $DOAS_CONF"
    }

    check_doas || die "Effective doas policy verification failed"
}

check_sshd()
{
    /usr/sbin/sshd -t >/dev/null 2>&1 || return 1
    rcctl ls on | grep -qx sshd || return 1
    rcctl check sshd >/dev/null 2>&1
}

apply_sshd()
{
    /usr/sbin/sshd -t ||
        die "Existing sshd configuration is invalid"

    if ! rcctl ls on | grep -qx sshd; then
        log "Enabling sshd"
        rcctl enable sshd
    fi

    if ! rcctl check sshd >/dev/null 2>&1; then
        log "Starting sshd"
        rcctl start sshd
    fi

    check_sshd || die "sshd is not ready"
}

# True when the given interpreter satisfies the configured version
# range. The candidate does the comparison itself, so there is no
# shell-side version arithmetic and no dependence on its file name.
python_compatible()
{
    "$1" -c '
import sys

def parse(text):
    return tuple(int(part) for part in text.split("."))

wanted = parse(sys.argv[1])
if sys.version_info[:len(wanted)] < wanted:
    sys.exit(1)

if sys.argv[2]:
    ceiling = parse(sys.argv[2])
    if sys.version_info[:len(ceiling)] > ceiling:
        sys.exit(1)
' "$PYTHON_MIN" "$PYTHON_MAX" >/dev/null 2>&1
}

# Print the absolute path of the newest compatible interpreter, or
# return 1 when there is none. Only versioned names are considered: an
# unversioned python3 symlink may be absent, and its target can change
# underneath the inventory.
find_python()
{
    ordered=

    # The globs yield ascending versions, so prepending each match
    # leaves the list in descending order.
    for candidate in "$PYTHON_DIR"/python3.[0-9] \
                     "$PYTHON_DIR"/python3.[0-9][0-9]
    do
        [ -x "$candidate" ] || continue
        ordered="$candidate${ordered:+ }$ordered"
    done

    for candidate in $ordered; do
        if python_compatible "$candidate"; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

check_python()
{
    find_python >/dev/null
}

# Print the fully qualified name of the newest available package whose
# stem is exactly the interpreter and whose version satisfies the
# configured range, or return 1 if the repository offers none.
#
# Two traps here. pkg_info -Q matches substrings, so asking for
# "python" also returns unrelated packages (bpython, py3-GitPython),
# subpackages (python-tkinter-3.13.13), and debug packages
# (debug-python-3.13.13); requiring the stem at the start of the line
# followed immediately by a digit selects only the interpreter itself.
# And an unqualified stem is ambiguous — `pkg_add python` prompts to
# choose between 2.7 and 3.x — so the exact name is what gets
# installed, which removes the prompt rather than relying on pkg_add's
# behaviour when its stdin is closed.
# Returns 2 if the repository could not be queried at all and 1 if it
# was queried but offers nothing suitable. Those are different faults
# and get different diagnostics.
find_python_package()
{
    available=$(run_bounded "$PKG_TIMEOUT" \
        pkg_info -Q "$PYTHON_PACKAGE_STEM") || return 2

    # Empty output means the query did not really work: any reachable
    # repository returns many packages matching the stem as a
    # substring. Do not rely on the exit status alone to notice —
    # pkg_add is known to report a package it cannot find as a warning
    # and still exit zero, and pkg_info may do the same. Reporting
    # this as "nothing suitable" would point at the wrong fix.
    [ -n "$available" ] || return 2

    printf '%s\n' "$available" |
        awk -v stem="$PYTHON_PACKAGE_STEM" \
            -v min="$PYTHON_MIN" -v max="$PYTHON_MAX" '
        function cmp(amaj, aminr, bmaj, bminr, bn) {
            if (amaj != bmaj) return (amaj < bmaj) ? -1 : 1
            # A bound naming only a major version constrains only it.
            if (bn < 2) return 0
            if (aminr != bminr) return (aminr < bminr) ? -1 : 1
            return 0
        }
        BEGIN {
            minn = split(min, mp, ".")
            if (max != "") maxn = split(max, xp, ".")
        }
        $0 ~ "^" stem "-[0-9]" {
            v = substr($0, length(stem) + 2)
            sub(/p[0-9]+$/, "", v)
            n = split(v, part, ".")
            maj = part[1] + 0
            minr = (n >= 2) ? part[2] + 0 : 0

            if (cmp(maj, minr, mp[1] + 0, mp[2] + 0, minn) < 0) next
            if (max != "" && cmp(maj, minr, xp[1] + 0, xp[2] + 0, maxn) > 0) next

            if (best == "" || maj > bmaj || (maj == bmaj && minr > bminr)) {
                bmaj = maj
                bminr = minr
                best = $0
            }
        }
        END { if (best == "") exit 1; print best }
    '
}

apply_python()
{
    # Discovery before installation: any compatible interpreter
    # already on the host satisfies the contract, and reinstalling on
    # every boot would be pure churn.
    check_python && return 0

    log "No compatible Python interpreter is installed; querying packages"

    status=0
    package=$(find_python_package) || status=$?

    if [ "$status" -ne 0 ]; then
        if [ "$status" -eq 2 ]; then
            log "Could not query the package repository within ${PKG_TIMEOUT}s."
            log "Check network reachability and PKG_PATH."
        else
            log "The repository offers no $PYTHON_PACKAGE_STEM package within the"
            log "configured range (minimum $PYTHON_MIN${PYTHON_MAX:+, maximum $PYTHON_MAX})."
            log "Confirm that range against the ansible-core release in use."
        fi

        log "Boot continues; a later boot or a manual apply will retry."
        die "No installable Python interpreter found"
    fi

    log "Installing $package"

    # pkg_add's exit status is not a trustworthy install-succeeded
    # signal: it reports a package it cannot find as a warning. Log a
    # failure, but let the verification below be the gate.
    if ! run_bounded "$PKG_TIMEOUT" pkg_add "$package"; then
        log "pkg_add reported failure or exceeded ${PKG_TIMEOUT}s"
    fi

    python_path=$(find_python) ||
        die "Installed $package but no interpreter in $PYTHON_DIR satisfies" \
            "Python >= $PYTHON_MIN"

    log "Installed Python interpreter: $python_path"
}

check_all()
{
    failed=0

    if check_key_source; then
        report_key
    else
        log "Controller public key: NOT READY"
        failed=1
    fi

    for item in account authorized_key doas sshd; do
        if "check_$item"; then
            log "$item: OK"
        else
            log "$item: NOT READY"
            failed=1
        fi
    done

    # Reported rather than merely confirmed: the controller needs this
    # absolute path for ansible_python_interpreter.
    if python_path=$(find_python); then
        log "python: OK (ansible_python_interpreter=$python_path)"
    else
        log "python: NOT READY (no interpreter >= $PYTHON_MIN found)"
        failed=1
    fi

    return "$failed"
}

apply_all()
{
    apply_key_source
    apply_account
    apply_authorized_key
    apply_doas
    apply_sshd
    apply_python

    check_all || die "Final readiness verification failed"
    log "System is Ansible-ready"
}

require_root

case "${1:-}" in
    init)
        init_key
        apply_all
        ;;
    check)
        check_all
        ;;
    apply)
        apply_all
        ;;
    *)
        echo "Usage: $0 {init|check|apply}" >&2
        exit "$EX_CONFIG"
        ;;
esac
