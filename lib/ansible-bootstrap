#!/bin/sh
#
# ansible-bootstrap — shared reconciliation engine
#
# Platform-independent. Everything that differs between operating
# systems — account creation, package installation, privilege
# escalation, service management — lives behind the small set of
# adapter_* functions and constants documented in adapter-contract.md,
# supplied by the OS adapter sourced below.
#
# init:
#   ANSIBLE_PUBLIC_KEY='ssh-ed25519 ...' \
#     ANSIBLE_EXPECTED_FINGERPRINT='SHA256:...' \
#     ansible-bootstrap init
#
# check:
#   ansible-bootstrap check
#
# apply:
#   ansible-bootstrap apply
#
# Must run as root. Never accepts an SSH private key.

set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/bin
export PATH

ACCOUNT=ansible
HOME_DIR=/home/ansible

CONFIG_DIR=/etc/ansible-bootstrap
KEY_FILE=$CONFIG_DIR/controller.pub

# The OS adapter. Sourced as root, so it is code, not configuration:
# its ownership and permissions are verified before it is read, for the
# same reason the repository README forbids sourcing an untrusted
# configuration file.
ADAPTER=/usr/local/libexec/ansible-bootstrap-adapter

# Markers for the managed block in doas.conf. Only the doas style uses
# them: a sudoers drop-in is a whole file this service owns, so there is
# nothing to mark off inside somebody else's file.
DOAS_BEGIN='# BEGIN ansible-bootstrap'
DOAS_END='# END ansible-bootstrap'

# The v0.2 marker, recognized so an upgrade does not append a second
# copy of the rule.
DOAS_LEGACY='# Managed by ansible-bootstrap'

# Mode for a sudoers drop-in. sudo ignores a policy file that is
# writable by group or other, and one owned by a non-root uid, so both
# are part of whether the rule takes effect at all rather than hygiene:
#
#   sudo: /usr/pkg/etc/sudoers.d/ansible-bootstrap is owned by uid 1001,
#         should be 0
#
# The same mode twice, in the two notations needed -- chmod's and the
# one `ls -l` prints -- kept adjacent because they must agree.
SUDOERS_MODE=0440
SUDOERS_MODE_LS='-r--r-----'

# Managed-node interpreter requirements of the ansible-core release
# the controller runs. Set here for ansible-core 2.21, which supports
# managed nodes on Python 3.9 through 3.14. Re-derive these from the
# support matrix when the controller's ansible-core changes; this is
# Ansible policy and so belongs to the engine, not to an adapter.
# PYTHON_MAX may be empty, meaning no upper bound, but every released
# ansible-core has one.
PYTHON_MIN=3.9
PYTHON_MAX=3.14

# Where packages install interpreters. The same on both BSDs; an
# adapter may reassign it.
PYTHON_DIR=/usr/local/bin

# Wall-clock bound in seconds on a package operation. The boot hook is
# a startup task, not a supervised service manager: an unreachable
# mirror must fail and return control to the boot sequence rather than
# stall it indefinitely.
PKG_TIMEOUT=300

# Exit-status contract:
#   0  ready, or reconciliation succeeded
#   1  a prerequisite is missing, or reconciliation failed
#   2  invalid invocation, or this service's own configuration is
#      absent, malformed, or unsafe
#
# The dividing line: status 2 means the inputs are wrong and repeating
# the run cannot help; status 1 means the managed host state is wrong,
# which a later boot or a manual apply may resolve.
EX_NOTREADY=1
EX_CONFIG=2

CHANGES=0

log()
{
    printf 'ansible-bootstrap: %s\n' "$*" >&2
}

# Record a modification to the host. Counted so a run can say whether
# it changed anything, and prefixed so the whole history of changes can
# be grepped back out of an append-only boot log.
changed()
{
    CHANGES=$((CHANGES + 1))
    log "change: $*"
}

# A run header. Without one, successive boots append indistinguishable
# blocks with no indication of when they happened or what was asked
# for. The clock is set from the RTC before rc.local runs, so a
# boot-time stamp is trustworthy to within whatever ntpd corrects later.
log_header()
{
    log "--- $(date -u '+%Y-%m-%dT%H:%M:%SZ') $1 ---"
}

die()
{
    log "ERROR: $*"
    exit "$EX_NOTREADY"
}

die_config()
{
    log "ERROR: $*"
    exit "$EX_CONFIG"
}

require_root()
{
    [ "$(id -u)" -eq 0 ] || die_config "Run as root"
}

# Mode string and numeric owner and group of a path, as
# "<ten-character mode> <uid> <gid>". Empty if the path is absent.
# ls(1) is used because stat(1) format flags are not portable across
# the BSDs; -n keeps the IDs numeric so no name lookup is involved.
path_status()
{
    ls -ldn "$1" 2>/dev/null |
        awk 'NR == 1 { print substr($1, 1, 10), $3, $4 }'
}

# True when a path has exactly the expected "<mode> <uid> <gid>".
expect_path()
{
    [ "$(path_status "$1")" = "$2" ]
}

# True when a path is writable by neither group nor other, which is
# what sshd's StrictModes requires of a home directory. Positions 6
# and 9 of the mode string are the group and other write bits.
owner_writable_only()
{
    mode=$(path_status "$1")
    mode=${mode%% *}

    [ -n "$mode" ] || return 1

    case "$mode" in
        ?????w????) return 1 ;;
        ????????w?) return 1 ;;
    esac
}

# Load the OS adapter. It is sourced, so it executes as root with all
# the privilege this program has; treat it exactly as strictly as the
# stored key. Verifying it here, rather than trusting the path, is the
# same rule the repository README states about not sourcing untrusted
# configuration as shell code.
#
# This has to come after the path helpers above and before any
# adapter_* call below. Shell functions resolve at call time, so an
# adapter may freely call engine functions defined further down.
load_adapter()
{
    [ ! -L "$ADAPTER" ] ||
        die_config "Refusing symlinked adapter: $ADAPTER"

    expect_path "$ADAPTER" "-rwx------ 0 0" ||
        die_config "$ADAPTER must exist, owned by root:wheel, mode 0700"

    . "$ADAPTER"

    # An adapter that sets no escalation style, or one this engine does
    # not implement, would otherwise fall through every case below and
    # configure no escalation at all -- reporting a host as ready that
    # Ansible cannot actually use. Checked here, once, rather than
    # defended against at each use.
    case "${ESCALATION_STYLE:-}" in
        doas | sudo)
            ;;
        '')
            die_config "$ADAPTER sets no ESCALATION_STYLE"
            ;;
        *)
            die_config "$ADAPTER sets an unknown ESCALATION_STYLE:" \
                "$ESCALATION_STYLE"
            ;;
    esac

    for adapter_const in LOGIN_SHELL ESCALATION_BIN ESCALATION_CONF \
        ESCALATION_POLICY ESCALATION_VALIDATE; do
        eval "adapter_value=\${$adapter_const:-}"

        [ -n "$adapter_value" ] ||
            die_config "$ADAPTER sets no $adapter_const"
    done
}

# Signal a process and everything beneath it, deepest first.
#
# Depth first, and children before their parent, because once a parent
# dies its children are reparented to init and can no longer be found by
# walking down from it. Killing top-down leaves exactly the orphans this
# is here to prevent.
kill_tree()
{
    for bounded_child in $(pgrep -P "$1" 2>/dev/null); do
        kill_tree "$bounded_child" "$2"
    done

    kill -"$2" "$1" 2>/dev/null || :
}

# Run a command under a wall-clock bound, returning its own exit status,
# or 124 if it had to be killed. A poll loop rather than timeout(1), so
# there is no dependency to confirm on the target release. stdin is
# closed: a package tool that decides to ask a question must fail rather
# than wait at boot for an answer that will never come.
#
# Two things here were learned the hard way, by hanging a FreeBSD guest
# for 617 seconds under a 15-second bound.
#
# The command's stdout goes to a file, never to the descriptor this
# function was called with. A command substitution's pipe stays open
# until every process holding its write end exits — so one surviving
# grandchild keeps the *caller* blocked for as long as it runs, however
# promptly this function returns. Writing to a file removes the
# dependency instead of racing it.
#
# And the tree is walked to find what to kill. `set -m` was tried first,
# on the theory that job control would put the command in its own process
# group: FreeBSD's sh leaves a background job in the caller's group, so
# the group kill either finds no such group or would take this engine
# down with it. Checking that `wait` preserves a status under `set -m`,
# which it does, says nothing about whether a process group was created.
run_bounded()
{
    limit=$1
    shift

    bounded_out=$(mktemp /var/run/ansible-bootstrap.XXXXXXXX) || {
        log "Cannot create temporary output file for: $*"
        return 1
    }

    "$@" < /dev/null > "$bounded_out" &
    bounded_pid=$!

    waited=0
    while [ "$waited" -lt "$limit" ]; do
        kill -0 "$bounded_pid" 2>/dev/null || break
        sleep 1
        waited=$((waited + 1))
    done

    bounded_status=0

    if kill -0 "$bounded_pid" 2>/dev/null; then
        log "Exceeded ${limit}s; terminating: $*"

        # A brace group, not a subshell: `wait` has to stay in the shell
        # that owns the job. stderr is discarded across the whole
        # sequence because NetBSD's sh announces the reaping of a
        # signal-killed background job, naming this function's own
        # internals in the operator's log:
        #
        #   [1]   Terminated   "${@}" </dev/null >"${bounded_out}"
        #
        # It appears on the timeout path only, which is exactly the log
        # a human reads after an unattended boot-time failure. OpenBSD
        # and FreeBSD are silent here; measured on all three.
        #
        # Nothing in the group diagnoses anything: the kills already
        # tolerate failure and sleep says nothing.
        {
            kill_tree "$bounded_pid" TERM
            sleep 2
            kill_tree "$bounded_pid" KILL

            wait "$bounded_pid"
        } 2>/dev/null

        bounded_status=124
    else
        wait "$bounded_pid" || bounded_status=$?
    fi

    cat "$bounded_out"
    rm -f "$bounded_out"

    return "$bounded_status"
}

# Compare SSH key type and base64 material, ignoring comments.
key_fields()
{
    awk 'NF >= 2 { print $1, $2; exit }' "$1"
}

validate_key()
{
    [ -f "$1" ] && [ ! -L "$1" ] || return 1

    # v0.2 accepts exactly one Ed25519 public key.
    awk '
        NF == 0 { next }
        {
            count++
            if ($1 != "ssh-ed25519" || NF < 2)
                bad = 1
        }
        END { exit (count != 1 || bad) }
    ' "$1" || return 1

    ssh-keygen -lf "$1" -E sha256 >/dev/null 2>&1
}

fingerprint()
{
    ssh-keygen -lf "$1" -E sha256 |
        awk '{ print $2 }'
}

report_key()
{
    log "Controller public key fingerprint: $(fingerprint "$KEY_FILE")"
}

init_key()
{
    [ -n "${ANSIBLE_PUBLIC_KEY:-}" ] ||
        die_config "Set ANSIBLE_PUBLIC_KEY to an SSH public key"

    [ ! -L "$CONFIG_DIR" ] ||
        die_config "Refusing symlinked configuration directory"

    install -d -o root -g wheel -m 0700 "$CONFIG_DIR"

    tmp=$(mktemp "$CONFIG_DIR/controller.pub.XXXXXXXX") ||
        die "Cannot create temporary key file"

    # Remove the temporary file on initialization failure.
    trap 'rm -f "$tmp"' EXIT HUP INT TERM

    printf '%s\n' "$ANSIBLE_PUBLIC_KEY" > "$tmp"
    chmod 0600 "$tmp"

    validate_key "$tmp" ||
        die_config "Invalid public key; expected one Ed25519 key"

    actual=$(fingerprint "$tmp")
    log "Supplied public key fingerprint: $actual"

    if [ -n "${ANSIBLE_EXPECTED_FINGERPRINT:-}" ]; then
        [ "$actual" = "$ANSIBLE_EXPECTED_FINGERPRINT" ] ||
            die_config "Fingerprint does not match expected value"
        log "Expected fingerprint verified"
    else
        log "WARNING: No independent expected fingerprint supplied"
    fi

    # Refuse to silently replace an existing controller key.
    if [ -e "$KEY_FILE" ] || [ -L "$KEY_FILE" ]; then
        validate_key "$KEY_FILE" ||
            die_config "Existing controller key is invalid"

        if [ "$(key_fields "$tmp")" != "$(key_fields "$KEY_FILE")" ]; then
            die_config "A different controller key already exists; refusing replacement"
        fi

        log "Existing controller key matches"
        return 0
    fi

    mv "$tmp" "$KEY_FILE"
    chmod 0600 "$KEY_FILE"
    chown root:wheel "$KEY_FILE"

    changed "Controller public key saved"
}

# The key file is the local trust anchor: a key an unprivileged user
# can rewrite is worthless, so ownership and permissions are part of
# the invariant, not just the contents.
check_key_source()
{
    validate_key "$KEY_FILE" || return 1

    [ ! -L "$CONFIG_DIR" ] || return 1

    expect_path "$CONFIG_DIR" "drwx------ 0 0" || return 1
    expect_path "$KEY_FILE" "-rw------- 0 0"
}

# Repair ownership and permissions of the stored key. Never creates or
# replaces the key itself; that is init's responsibility.
apply_key_source()
{
    check_key_source && return 0

    [ ! -L "$CONFIG_DIR" ] ||
        die_config "Refusing symlinked configuration directory"

    validate_key "$KEY_FILE" ||
        die_config "Initialize the controller public key first"

    changed "Repairing ownership and permissions of $KEY_FILE"

    chown root:wheel "$CONFIG_DIR" "$KEY_FILE"
    chmod 0700 "$CONFIG_DIR"
    chmod 0600 "$KEY_FILE"

    check_key_source || die "Key configuration verification failed"
}

# Use the account database, not a guessed passwd-file layout.
account_record()
{
    getent passwd "$ACCOUNT"
}

# Numeric uid and gid of the account, as "<uid> <gid>". The passwd
# entry is the single source of truth for both checking and setting
# ownership, so neither depends on a group that happens to share the
# account name.
account_ids()
{
    record=$(account_record) || return 1

    printf '%s\n' "$record" | awk -F: '{ print $3, $4 }'
}

check_account()
{
    record=$(account_record) || return 1

    uid=$(printf '%s\n' "$record" | awk -F: '{print $3}')
    home=$(printf '%s\n' "$record" | awk -F: '{print $6}')
    shell=$(printf '%s\n' "$record" | awk -F: '{print $7}')

    [ "$home" = "$HOME_DIR" ] || return 1
    [ "$shell" = "$LOGIN_SHELL" ] || return 1
    [ -d "$HOME_DIR" ] && [ ! -L "$HOME_DIR" ] || return 1

    # sshd refuses public-key authentication when the home directory
    # is owned by anyone else or is writable by group or other.
    [ "$(path_status "$HOME_DIR" | awk '{print $2}')" = "$uid" ] || return 1
    owner_writable_only "$HOME_DIR"
}

apply_account()
{
    if ! id "$ACCOUNT" >/dev/null 2>&1; then
        changed "Creating $ACCOUNT account"
        adapter_create_account
    fi

    # The home directory belongs to the administrator, not to this
    # service; report a conflict rather than relaxing or tightening it.
    if ! check_account; then
        log "The $ACCOUNT account must have home $HOME_DIR, shell"
        log "$LOGIN_SHELL, and a home directory that it owns and that"
        log "is not writable by group or other."
        die "Account does not satisfy the readiness contract"
    fi
}

# Look for the configured key in an authorized_keys file.
#
#   mode "exact"  an ordinary entry with no preceding options, which is
#                 what the readiness contract requires
#   mode "any"    the same key material wherever it appears, including
#                 behind options such as from= or command=
#
# Options may be quoted and contain spaces, so the key is located by
# scanning for the type immediately followed by its base64 material
# rather than by assuming a field position. Comments are skipped: a
# commented-out key must not count as present in either mode.
#
# Key presence is a separate question from file ownership and
# permissions. Conflating the two would make a permission fault look
# like a missing key and append a duplicate.
authorized_key_match()
{
    [ -f "$2" ] || return 1

    awk -v mode="$1" '
        NR == FNR {
            if (NF >= 2) {
                type = $1
                key = $2
            }
            next
        }
        /^[ \t]*#/ { next }
        {
            for (i = 1; i < NF; i++) {
                if ($i != type || $(i + 1) != key)
                    continue
                if (mode == "any" || i == 1)
                    found = 1
            }
        }
        END { exit !found }
    ' "$KEY_FILE" "$2"
}

check_authorized_key()
{
    check_key_source && check_account || return 1

    ids=$(account_ids) || return 1

    ssh_dir=$HOME_DIR/.ssh
    auth=$ssh_dir/authorized_keys

    [ -d "$ssh_dir" ] && [ ! -L "$ssh_dir" ] || return 1
    [ -f "$auth" ] && [ ! -L "$auth" ] || return 1

    expect_path "$ssh_dir" "drwx------ $ids" || return 1
    expect_path "$auth" "-rw------- $ids" || return 1

    authorized_key_match exact "$auth"
}

apply_authorized_key()
{
    check_key_source || die_config "Controller public key is missing or invalid"

    ssh_dir=$HOME_DIR/.ssh
    auth=$ssh_dir/authorized_keys

    [ ! -L "$ssh_dir" ] && [ ! -L "$auth" ] ||
        die "Refusing symlinked SSH paths"

    ids=$(account_ids) || die "No passwd entry for $ACCOUNT"

    uid=${ids%% *}
    gid=${ids##* }

    # Created root-owned, then given to the account below, so the
    # ownership rule lives in exactly one place.
    if [ ! -d "$ssh_dir" ]; then
        install -d -m 0700 "$ssh_dir"
    fi

    if [ ! -e "$auth" ]; then
        install -m 0600 /dev/null "$auth"
    fi

    [ -f "$auth" ] || die "authorized_keys is not a regular file"

    if ! authorized_key_match exact "$auth"; then
        # Already there, but behind options that restrict what it can
        # do. Appending an unrestricted copy would duplicate the key
        # and quietly override a deliberate administrative narrowing.
        if authorized_key_match any "$auth"; then
            log "The controller key is present in $auth but carries"
            log "restricting options, so it cannot serve general"
            log "provisioning. Refusing to append an unrestricted"
            log "second copy of the same key."
            die "Resolve the restricted controller key entry by hand"
        fi

        changed "Installing controller key: $(fingerprint "$KEY_FILE")"
        cat "$KEY_FILE" >> "$auth"
    fi

    # Repair only what is actually wrong, and say so. These are files
    # this service creates and owns, and the contract names their
    # modes, so correcting them is right — but doing it silently on
    # every run hid the fact that something had changed them, and left
    # a no-op apply still writing to files it need not touch.
    if ! expect_path "$ssh_dir" "drwx------ $ids"; then
        changed "Repairing ownership and permissions of $ssh_dir"
        chown "$uid:$gid" "$ssh_dir"
        chmod 0700 "$ssh_dir"
    fi

    if ! expect_path "$auth" "-rw------- $ids"; then
        changed "Repairing ownership and permissions of $auth"
        chown "$uid:$gid" "$auth"
        chmod 0600 "$auth"
    fi

    check_authorized_key ||
        die "authorized_keys verification failed"
}

# The become_method the controller must use for the mechanism in
# effect. Reported by `check` for the same reason the Python
# interpreter path is: it is a setting the controller cannot derive and
# has to be told.
#
# doas is not in ansible-core; its become plugin comes from the
# community.general collection, so the name is fully qualified. sudo is
# built in.
become_method()
{
    case "$ESCALATION_STYLE" in
        doas) echo community.general.doas ;;
        sudo) echo sudo ;;
    esac
}

# The rule granting the account passwordless root, as the mechanism in
# effect spells it. One function so that the text written by `apply` and
# the text compared against by the drift check cannot drift apart.
escalation_rule()
{
    case "$ESCALATION_STYLE" in
        doas) printf 'permit nopass %s as root\n' "$ACCOUNT" ;;
        sudo) printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$ACCOUNT" ;;
    esac
}

# Test the effective escalation policy as the ansible user.
#
# Shared between mechanisms: doas and sudo both take -n to mean "fail
# rather than prompt", which is exactly the question being asked. What
# differs is only the path, which the adapter supplies.
#
# Deliberately NOT a login shell: `su -` would source /etc/profile and
# ~/.profile, whose output would be captured along with the command's
# and break the comparison below on a host where escalation works fine.
# A non-login shell is also the more faithful test, because Ansible runs
# `ssh host command`, which is not a login shell either. Nothing here
# needs the login environment -- the escalation tool and id are invoked
# by absolute path.
#
# The whole output must be exactly "0". Matching loosely, to tolerate
# stray output, would risk reading a bare 0 printed by something else
# as proof of success; failing on unexpected output is the safer
# direction.
#
# Note what is NOT tested: whether this service wrote the policy. The
# contract is that the account can reach root noninteractively, not that
# this program is the reason. An administrator who granted it in
# sudoers directly has satisfied the invariant, and `apply` then returns
# without writing a drop-in rather than adding a second grant. Requiring
# ESCALATION_CONF to exist here would have reported such a host as not
# ready and then refused to "fix" it.
check_escalation()
{
    result=$(su "$ACCOUNT" -c \
        "$ESCALATION_BIN -n /usr/bin/id -u" 2>/dev/null) ||
        return 1

    [ "$result" = 0 ]
}

# True when a previous run already wrote the managed block. doas only:
# the sudo style owns its file outright and compares content instead.
managed_doas_rule()
{
    [ -f "$ESCALATION_CONF" ] || return 1

    grep -Fqx "$DOAS_BEGIN" "$ESCALATION_CONF" ||
        grep -Fqx "$DOAS_LEGACY" "$ESCALATION_CONF"
}

# True when any rule the administrator wrote names the account.
#
# Read from ESCALATION_POLICY, the administrator's file, which is not
# always the file this service writes: under the sudo style policy lives
# in sudoers and this service owns only a drop-in. Scanned either way,
# because both mechanisms resolve last match wins, and this service's
# rule is evaluated last -- doas.conf because the managed block is
# appended, sudoers because @includedir is the final effective line of
# the shipped file. Granting itself root after such a rule would
# silently override a deliberate policy decision.
administrator_escalation_rule()
{
    [ -f "$ESCALATION_POLICY" ] || return 1

    awk -v account="$ACCOUNT" '
        /^[ \t]*#/ { next }
        NF == 0 { next }
        {
            for (i = 1; i <= NF; i++)
                if ($i == account)
                    found = 1
        }
        END { exit !found }
    ' "$ESCALATION_POLICY"
}

refuse_administrator_policy()
{
    administrator_escalation_rule || return 0

    log "$ESCALATION_POLICY already has a rule naming $ACCOUNT that does"
    log "not permit passwordless root access."
    die "Refusing to override administrator $ESCALATION_STYLE policy"
}

# Validate a candidate policy file with the mechanism's own parser, and
# remove it if it does not pass.
#
# Unquoted on purpose: ESCALATION_VALIDATE is a command and its
# arguments -- `doas -C`, `visudo -c -f` -- and word splitting is how a
# POSIX shell passes those on.
validate_escalation_file()
{
    $ESCALATION_VALIDATE "$1" >/dev/null 2>&1 && return 0

    rm -f "$1"
    die "Generated $ESCALATION_STYLE configuration is invalid"
}

install_escalation_file()
{
    mv "$1" "$ESCALATION_CONF" || {
        rm -f "$1"
        die "Cannot install $ESCALATION_CONF"
    }
}

# Append a managed block to doas.conf -- a file belonging to the
# administrator, so unrelated content is preserved and only the block
# between the markers is this service's to write.
apply_escalation_doas()
{
    # The block is already installed but is not effective. Appending
    # another copy would not change the outcome and would grow
    # doas.conf by two lines on every boot.
    #
    # Checked before the administrator scan below, not after: that scan
    # matches any uncommented line naming the account, which includes
    # this service's own rule.
    if managed_doas_rule; then
        log "$ESCALATION_CONF already contains the managed rule for"
        log "$ACCOUNT, but doas -n still fails. A later rule may override"
        log "it, or the account may be locked or otherwise unusable."
        die "Refusing to append a duplicate doas rule; resolve this by hand"
    fi

    refuse_administrator_policy

    changed "Configuring passwordless doas"

    [ ! -L "$ESCALATION_CONF" ] ||
        die "Refusing symlinked doas.conf"

    doas_tmp=$(mktemp "$ESCALATION_CONF.XXXXXXXX") ||
        die "Cannot create temporary doas configuration"

    if [ -f "$ESCALATION_CONF" ]; then
        cat "$ESCALATION_CONF" > "$doas_tmp"
    fi

    # Last matching rule wins in doas.conf, so the managed block goes
    # at the end. The markers let later runs recognize it.
    {
        printf '\n%s\n' "$DOAS_BEGIN"
        escalation_rule
        printf '%s\n' "$DOAS_END"
    } >> "$doas_tmp"

    chmod 0600 "$doas_tmp"
    chown root:wheel "$doas_tmp"

    validate_escalation_file "$doas_tmp"
    install_escalation_file "$doas_tmp"
}

# True when the drop-in is already exactly what this service would
# write, in content, ownership and mode.
#
# The sudo style has no marker to look for, because it does not write
# into anybody else's file -- which also means the file merely existing
# is no evidence that it is right, the way a marker is. Comparing
# content instead buys back drift repair: a truncated, re-owned or
# chmodded drop-in is rewritten, and only a drop-in that is already
# correct while escalation still fails is treated as a conflict.
sudoers_dropin_correct()
{
    [ -f "$ESCALATION_CONF" ] || return 1
    [ ! -L "$ESCALATION_CONF" ] || return 1

    expect_path "$ESCALATION_CONF" "$SUDOERS_MODE_LS 0 0" || return 1

    [ "$(cat "$ESCALATION_CONF")" = "$(escalation_rule)" ]
}

# Write a sudoers drop-in: a whole file this service owns, so the
# correct content can simply be written rather than edited into place.
apply_escalation_sudo()
{
    if sudoers_dropin_correct; then
        log "$ESCALATION_CONF already grants $ACCOUNT passwordless root,"
        log "but sudo -n still fails. A rule later in $ESCALATION_POLICY"
        log "may override it, the @includedir line may be missing, or the"
        log "account may be locked or otherwise unusable."
        die "Refusing to rewrite a correct sudoers drop-in; resolve by hand"
    fi

    refuse_administrator_policy

    changed "Configuring passwordless sudo"

    [ ! -L "$ESCALATION_CONF" ] ||
        die "Refusing symlinked $ESCALATION_CONF"

    # Measured present after installing the sudo package on both
    # FreeBSD 15.1 and NetBSD 11.0 -- but the doas package on NetBSD
    # ships no PKG_SYSCONFDIR at all, and the failure mode there was a
    # mktemp ENOENT that said nothing about the real cause. Creating it
    # costs one stat.
    sudoers_dir=${ESCALATION_CONF%/*}

    if [ ! -d "$sudoers_dir" ]; then
        changed "Creating $sudoers_dir for sudo policy"

        install -d -o root -g wheel -m 0755 "$sudoers_dir" ||
            die "Cannot create $sudoers_dir"
    fi

    # The temporary file is created inside the included directory, so
    # sudo may parse it for as long as it exists. Harmless: its content
    # is byte for byte what is about to be installed under the real
    # name, and it is validated before the rename.
    sudoers_tmp=$(mktemp "$ESCALATION_CONF.XXXXXXXX") ||
        die "Cannot create temporary sudoers drop-in"

    escalation_rule > "$sudoers_tmp"

    chown root:wheel "$sudoers_tmp"
    chmod "$SUDOERS_MODE" "$sudoers_tmp"

    validate_escalation_file "$sudoers_tmp"
    install_escalation_file "$sudoers_tmp"
}

apply_escalation()
{
    check_escalation && return 0

    # doas is in the base system on OpenBSD but both doas and sudo are
    # packages elsewhere, so on some platforms escalation cannot be
    # configured until the package manager has worked. That inverts part
    # of the ordering this function can otherwise assume.
    adapter_escalation_prepare

    case "$ESCALATION_STYLE" in
        doas) apply_escalation_doas ;;
        sudo) apply_escalation_sudo ;;
    esac

    check_escalation ||
        die "Effective $ESCALATION_STYLE policy verification failed"
}

check_sshd()
{
    /usr/sbin/sshd -t >/dev/null 2>&1 || return 1
    adapter_service_enabled sshd || return 1
    adapter_service_running sshd
}

apply_sshd()
{
    # Already correct: do not repeat the probes below and then repeat
    # them again in the closing verification.
    check_sshd && return 0

    /usr/sbin/sshd -t ||
        die "Existing sshd configuration is invalid"

    if ! adapter_service_enabled sshd; then
        changed "Enabling sshd"
        adapter_service_enable sshd
    fi

    if ! adapter_service_running sshd; then
        changed "Starting sshd"
        adapter_service_start sshd
    fi

    check_sshd || die "sshd is not ready"
}

# True when the given interpreter satisfies the configured version
# range. The candidate does the comparison itself, so there is no
# shell-side version arithmetic and no dependence on its file name.
python_compatible()
{
    "$1" -c '
import sys

def parse(text):
    return tuple(int(part) for part in text.split("."))

wanted = parse(sys.argv[1])
if sys.version_info[:len(wanted)] < wanted:
    sys.exit(1)

if sys.argv[2]:
    ceiling = parse(sys.argv[2])
    if sys.version_info[:len(ceiling)] > ceiling:
        sys.exit(1)
' "$PYTHON_MIN" "$PYTHON_MAX" >/dev/null 2>&1
}

# Print the absolute path of the newest compatible interpreter, or
# return 1 when there is none. Only versioned names are considered: an
# unversioned python3 symlink may be absent, and its target can change
# underneath the inventory.
find_python()
{
    ordered=

    # The globs yield ascending versions, so prepending each match
    # leaves the list in descending order.
    for candidate in "$PYTHON_DIR"/python3.[0-9] \
                     "$PYTHON_DIR"/python3.[0-9][0-9]
    do
        [ -x "$candidate" ] || continue
        ordered="$candidate${ordered:+ }$ordered"
    done

    for candidate in $ordered; do
        if python_compatible "$candidate"; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

check_python()
{
    find_python >/dev/null
}

# Print the name of the newest package the adapter offers whose version
# satisfies the configured range, or return non-zero if there is none.
#
# The adapter supplies one line per installable interpreter, as
# "<package-name> <major> <minor>". The split is deliberate: package
# naming differs sharply between platforms — OpenBSD's
# python-3.13.13 against FreeBSD's python311 — while *which* versions
# are acceptable is Ansible policy and belongs to the engine.
#
# Returns 2 if the repository could not be queried at all and 1 if it
# was queried but offers nothing suitable. Those are different faults
# and get different diagnostics.
find_python_package()
{
    available=$(adapter_python_packages) || return 2

    # Empty output means the query did not really work: any reachable
    # repository offers interpreters. Do not rely on the exit status
    # alone to notice — OpenBSD's pkg_add reports a package it cannot
    # find as a warning and still exits zero, so a query tool may do
    # the same. Reporting this as "nothing suitable" would point at the
    # wrong fix.
    [ -n "$available" ] || return 2

    printf '%s\n' "$available" |
        awk -v min="$PYTHON_MIN" -v max="$PYTHON_MAX" '
        function cmp(amaj, aminr, bmaj, bminr, bn) {
            if (amaj != bmaj) return (amaj < bmaj) ? -1 : 1
            # A bound naming only a major version constrains only it.
            if (bn < 2) return 0
            if (aminr != bminr) return (aminr < bminr) ? -1 : 1
            return 0
        }
        BEGIN {
            minn = split(min, mp, ".")
            if (max != "") maxn = split(max, xp, ".")
        }
        NF == 3 {
            maj = $2 + 0
            minr = $3 + 0

            if (cmp(maj, minr, mp[1] + 0, mp[2] + 0, minn) < 0) next
            if (max != "" && cmp(maj, minr, xp[1] + 0, xp[2] + 0, maxn) > 0) next

            if (best == "" || maj > bmaj || (maj == bmaj && minr > bminr)) {
                bmaj = maj
                bminr = minr
                best = $1
            }
        }
        END { if (best == "") exit 1; print best }
    '
}

apply_python()
{
    # Discovery before installation: any compatible interpreter
    # already on the host satisfies the contract, and reinstalling on
    # every boot would be pure churn.
    check_python && return 0

    log "No compatible Python interpreter is installed; querying packages"

    status=0
    package=$(find_python_package) || status=$?

    if [ "$status" -ne 0 ]; then
        if [ "$status" -eq 2 ]; then
            log "Could not query the package repository within ${PKG_TIMEOUT}s."
            log "Check network reachability and PKG_PATH."
        else
            log "The repository offers no Python interpreter within the"
            log "configured range (minimum $PYTHON_MIN${PYTHON_MAX:+, maximum $PYTHON_MAX})."
            log "Confirm that range against the ansible-core release in use."
        fi

        log "Boot continues; a later boot or a manual apply will retry."
        die "No installable Python interpreter found"
    fi

    changed "Installing $package"

    # A package tool's exit status is not a trustworthy
    # install-succeeded signal: OpenBSD's pkg_add reports a package it
    # cannot find as a warning and still exits zero. Log a failure, but
    # let the verification below be the gate.
    if ! adapter_package_install "$package"; then
        log "Package installation reported failure or exceeded ${PKG_TIMEOUT}s"
    fi

    python_path=$(find_python) ||
        die "Installed $package but no interpreter in $PYTHON_DIR satisfies" \
            "Python >= $PYTHON_MIN"

    log "Installed Python interpreter: $python_path"
}

check_all()
{
    failed=0

    if check_key_source; then
        report_key
    else
        log "Controller public key: NOT READY"
        failed=1
    fi

    for item in account authorized_key escalation sshd; do
        if "check_$item"; then
            # Reported rather than merely confirmed, like the Python
            # path below: which become_method to use is the other
            # setting the controller cannot derive for itself.
            case "$item" in
                escalation)
                    log "escalation: OK (ansible_become_method=$(become_method))"
                    ;;
                *)
                    log "$item: OK"
                    ;;
            esac
        else
            log "$item: NOT READY"
            failed=1
        fi
    done

    # Reported rather than merely confirmed: the controller needs this
    # absolute path for ansible_python_interpreter.
    if python_path=$(find_python); then
        log "python: OK (ansible_python_interpreter=$python_path)"
    else
        log "python: NOT READY (no interpreter >= $PYTHON_MIN found)"
        failed=1
    fi

    return "$failed"
}

apply_all()
{
    apply_key_source
    apply_account
    apply_authorized_key
    apply_escalation
    apply_sshd
    apply_python

    check_all || die "Final readiness verification failed"

    # Say whether this run actually did anything. On a boot hook that
    # runs every time, "did it repair drift or find nothing to do?" is
    # the question a log is read to answer.
    case "$CHANGES" in
        0) log "System is Ansible-ready; no changes were needed" ;;
        1) log "System is Ansible-ready; 1 change made" ;;
        *) log "System is Ansible-ready; $CHANGES changes made" ;;
    esac
}

require_root
load_adapter

case "${1:-}" in
    init)
        log_header init
        init_key
        apply_all
        ;;
    check)
        log_header check
        check_all
        ;;
    apply)
        log_header apply
        apply_all
        ;;
    *)
        echo "Usage: $0 {init|check|apply}" >&2
        exit "$EX_CONFIG"
        ;;
esac
